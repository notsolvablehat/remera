# Application related
PORT
RUST_LOG
APP_ENV

# database
DATABASE_URL

# security
AUTH_SECRET
# comma separated origins
FRONTEND_ALLOW_ORIGINS

# misc
BASE_URL

# object storage (Cloudflare R2, S3-compatible)
# Full S3 API endpoint for the bucket (from the R2 dashboard), e.g.
# https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT
R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME
# Not read by the backend (it's a Cloudflare account-level API token, not
# an S3 credential) — kept here for completeness only.
R2_API_KEY
# Cloudflare account id — not currently read (S3_ENDPOINT is used
# directly instead), kept for reference/future use.
R2_ACCOUNT_ID
